<form class="inline-form" method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" onsubmit="return confirm('Delete this category? This cannot be undone.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
    <button class="btn btn--danger btn--sm" type="submit">Delete</button>
</form>
