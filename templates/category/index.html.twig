{% extends 'base.html.twig' %}

{% block title %}Categories{% endblock %}
{% block breadcrumb %}Categories{% endblock %}

{% block body %}
    <section class="welcome-row">
        <div>
            <p class="eyebrow">HARVEST BREAD CO. / CATALOG</p>
            <h1>Categories</h1>
            <p class="page-subtitle">Group your products so they are easy to find.</p>
        </div>
        <a class="primary-button" href="{{ path('admin_category_new') }}"><span>+</span> New category</a>
    </section>

    <section class="summary-grid" aria-label="Category summary">
        <article class="summary-card">
            <div class="summary-topline">
                <span class="summary-title">TOTAL CATEGORIES</span>
                <span class="summary-icon summary-icon--orange">▣</span>
            </div>
            <div class="summary-value">{{ category_count }}</div>
            <p class="summary-note">Product groups in your catalog</p>
        </article>
        <article class="summary-card">
            <div class="summary-topline">
                <span class="summary-title">TOTAL PRODUCTS</span>
                <span class="summary-icon summary-icon--blue">▧</span>
            </div>
            <div class="summary-value">{{ product_count }}</div>
            <p class="summary-note">Products assigned to categories</p>
        </article>
        <article class="summary-card">
            <div class="summary-topline">
                <span class="summary-title">EMPTY CATEGORIES</span>
                <span class="summary-icon summary-icon--red">!</span>
            </div>
            <div class="summary-value">{{ empty_category_count }}</div>
            <p class="summary-note">Categories waiting for products</p>
        </article>
    </section>

    <section class="panel">
        <div class="panel-heading category-panel-heading">
            <div>
                <h2>Your product categories</h2>
                <p>Manage the groups customers use to browse your bakery products.</p>
            </div>
        </div>
        <div class="table-wrap">
            <table class="crud-table">
                <thead>
                    <tr><th>NAME</th><th>DESCRIPTION</th><th>PRODUCTS</th><th class="col-actions">ACTIONS</th></tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td><strong>{{ category.name }}</strong></td>
                        <td class="cell-wrap">{{ category.description|default('—') }}</td>
                        <td>{{ category.products|length }}</td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <a class="btn btn--ghost btn--sm" href="{{ path('admin_category_show', {id: category.id}) }}">View</a>
                                <a class="btn btn--ghost btn--sm" href="{{ path('admin_category_edit', {id: category.id}) }}">Edit</a>
                                {{ include('category/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="empty-state">No categories found. Create your first one to get started.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
