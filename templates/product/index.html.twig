{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}
{% block breadcrumb %}Products{% endblock %}

{% block body %}
    <section class="welcome-row">
        <div>
            <p class="eyebrow">HARVEST BREAD CO. / CATALOG</p>
            <h1>Products</h1>
            <p class="page-subtitle">Everything on your menu, with live stock levels.</p>
        </div>
        <a class="primary-button" href="{{ path('admin_product_new') }}"><span>+</span> New product</a>
    </section>

    <section class="panel">
        <form class="filter-bar" method="get" action="{{ path('admin_product_index') }}">
            <label for="category-filter">Category</label>
            <select id="category-filter" name="category">
                <option value="">All categories</option>
                {% for category in categories %}
                    <option value="{{ category.id }}"{{ category.id == selected_category ? ' selected' : '' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
            <button class="btn btn--ghost btn--sm" type="submit">Filter</button>
            {% if selected_category %}
                <a class="text-link" href="{{ path('admin_product_index') }}">Clear</a>
            {% endif %}
        </form>

        <div class="table-wrap">
            <table class="crud-table">
                <thead>
                    <tr><th>NAME</th><th>CATEGORY</th><th>PRICE</th><th>STOCK</th><th class="col-actions">ACTIONS</th></tr>
                </thead>
                <tbody>
                {% for product in products %}
                    <tr>
                        <td><strong>{{ product.name }}</strong></td>
                        <td>{{ product.category.name }}</td>
                        <td class="amount-cell">₱{{ product.price|number_format(2) }}</td>
                        <td>
                            {{ product.stock }}
                            {% if product.lowStock %}<span class="status status--pending">Low stock</span>{% endif %}
                        </td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <a class="btn btn--ghost btn--sm" href="{{ path('admin_product_show', {id: product.id}) }}">View</a>
                                <a class="btn btn--ghost btn--sm" href="{{ path('admin_product_edit', {id: product.id}) }}">Edit</a>
                                {{ include('product/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="empty-state">No products found.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
