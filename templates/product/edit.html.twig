{% extends 'base.html.twig' %}

{% block title %}Edit product{% endblock %}
{% block breadcrumb %}Products / Edit{% endblock %}

{% block body %}
    <section class="welcome-row">
        <div>
            <p class="eyebrow">HARVEST BREAD CO. / CATALOG</p>
            <h1>Edit {{ product.name }}</h1>
        </div>
        <a class="btn btn--ghost" href="{{ path('admin_product_index') }}">← Back to products</a>
    </section>

    <section class="panel form-card">
        {{ include('product/_form.html.twig', {button_label: 'Save changes'}) }}
    </section>
{% endblock %}
