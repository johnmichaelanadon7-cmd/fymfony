<form class="inline-form" method="post" action="{{ path('admin_product_delete', {id: product.id}) }}" onsubmit="return confirm('Delete this product? This cannot be undone.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
    <button class="btn btn--danger btn--sm" type="submit">Delete</button>
</form>
