{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}
{% block breadcrumb %}Products / {{ product.name }}{% endblock %}

{% block body %}
    <section class="welcome-row">
        <div>
            <p class="eyebrow">HARVEST BREAD CO. / CATALOG</p>
            <h1>{{ product.name }}</h1>
            <p class="page-subtitle">{{ product.category.name }}</p>
        </div>
        <div class="row-actions">
            <a class="btn btn--ghost" href="{{ path('admin_product_index') }}">← Back</a>
            <a class="btn btn--primary" href="{{ path('admin_product_edit', {id: product.id}) }}">Edit</a>
            {{ include('product/_delete_form.html.twig') }}
        </div>
    </section>

    <section class="panel">
        <dl class="detail-list">
            <div><dt>Price</dt><dd>₱{{ product.price|number_format(2) }}</dd></div>
            <div>
                <dt>Stock on hand</dt>
                <dd>{{ product.stock }} {% if product.lowStock %}<span class="status status--pending">Low stock</span>{% endif %}</dd>
            </div>
            <div><dt>Low-stock alert at</dt><dd>{{ product.lowStockThreshold }}</dd></div>
            <div>
                <dt>Category</dt>
                <dd><a class="text-link" href="{{ path('admin_category_show', {id: product.category.id}) }}">{{ product.category.name }}</a></dd>
            </div>
            <div class="detail-wide"><dt>Description</dt><dd>{{ product.description|default('—') }}</dd></div>
        </dl>
    </section>
{% endblock %}
